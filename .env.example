# Aiven MySQL connection information from the service Overview page
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=defaultdb
# Optional path to Aiven's downloaded CA certificate
DB_SSL_CA=

# External analysis services
GEMINI_API_KEY=
VIRUSTOTAL_API_KEY=

# Only needed for a separate manual cloudflared launcher.
# The installed Windows cloudflared service has its own configuration.
CLOUDFLARE_TUNNEL_TOKEN=
