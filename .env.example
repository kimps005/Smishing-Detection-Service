# Aiven MySQL connection information from the service Overview page
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=defaultdb
# Optional path to Aiven's downloaded CA certificate
DB_SSL_CA=
# Keep certificate verification enabled in production. Set 0 only for local testing.
DB_SSL_VERIFY=1

# External analysis services
GEMINI_API_KEY=
VIRUSTOTAL_API_KEY=
# Streamlit 관리자 화면에서 사용할 API 주소
API_URL=http://127.0.0.1:8000

# The first server start downloads the public model files when they are absent.
SMS_MODEL_QUANTIZED=1
SMS_CATEGORY_MODEL_PATH=
SMS_BASE_MODEL_PATH=
SMS_HF_REPO_ID=kimps005/sms-category-model
SMS_HF_MODEL_FILENAME=sms_category_model_int8_dynamic_state_dict.pt
SMS_HF_REVISION=b0267b3befd229165127de5cf402414d427863fa

# API safety limits
MAX_IMAGE_BYTES=10485760
MAX_FEEDBACK_IMAGE_BYTES=5242880
MAX_IMAGE_PIXELS=25000000
MAX_TEXT_LENGTH=20000
# 최대 동시 백그라운드 분석 작업 수
ANALYSIS_WORKERS=4
# 분석 요청 하나에서 검사할 최대 URL 수
MAX_URLS_PER_ANALYSIS=10

# Required to access /admin/logs. Send as Authorization: Bearer <token>.
ADMIN_TOKEN=

# Only needed for a separate manual cloudflared launcher.
# The installed Windows cloudflared service has its own configuration.
CLOUDFLARE_TUNNEL_TOKEN=
